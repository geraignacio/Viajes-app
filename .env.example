# ─── Base de datos (Supabase) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Runtime (Vercel): Transaction pooler, puerto 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones (Prisma CLI): Session pooler, puerto 5432 (compatible con IPv4).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local con docker-compose (ambas apuntan al mismo Postgres):
# DATABASE_URL="postgresql://viajes:viajes@localhost:5432/viajes"
# DIRECT_URL="postgresql://viajes:viajes@localhost:5432/viajes"

# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Redirect URIs autorizados:
#   http://localhost:3000/api/auth/callback/google
#   https://<tu-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Solo fuera de Vercel si la URL pública no se detecta sola:
# AUTH_URL="http://localhost:3000"
